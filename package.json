	"scripts": {
		"start": "NLLB_MODULE_PATH=${NLLB_MODULE_PATH:-./lib/nllbTranslate.local.js} node index.js",
		"dev": "NLLB_MODULE_PATH=${NLLB_MODULE_PATH:-./lib/nllbTranslate.local.js} nodemon index.js",
