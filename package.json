		"lightpanda": "nodemon lightpanda-browser.js",
		"dev:profiler": "nodemon index.js --firebase_env=profiler",
		"build": "npm install && npm install --only=dev",
		"test:load": "node tests/test-load.js",
		"pentest": "node tests/pentest-load.js",
		"pentest:pool": "node tests/test-load.js",
		"monitor": "node monitor-resources.js",
